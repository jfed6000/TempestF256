	sta	<TEMP0
	sta	<RY
	sta	QT5,u
	lbsr	RNKDSP			ALSCO2:901 JSR RNKDSP  ;DISPLAY RANKS
	lda	#$FF			ALSCO2:902 LDA I,-1  ;NO GLOW
