********************************************************************
* text.a - the text bitmap (docs/port-plan.md D3): the interpreter's
*   text list (window A + $1800, AV.TCNT entries of 6 bytes: glyph, $80
*   = big; CLUT index; column; row, both 16-bit signed, the beam
*   rounded) drawn as glyph masks (glyphs.a) into bitmap 2, which is
*   single-buffered and in front of the lines.
*
*   Only what changed is redrawn.  TXOLD holds the list as last drawn.
*   Entry i has changed when it differs from TXOLD's entry i, or one of
*   the lists has no entry i.  The changed old entries are erased (their
*   masks drawn in 0) and the rows they touched marked; then the changed
*   new entries are drawn, and so is every unchanged entry on a marked
*   row, since an erase may have taken a pixel it shared.  A list that
*   has not changed costs a compare of each entry.
*
*   The bitmap is reached a block at a time through the service window
*   (Map1, SWIN); a pixel's place is row * 320 + column, block and
*   offset in the 10 blocks from TXBLK.  Pixels off the bitmap are not
*   drawn.  Runs with U = the data area.
*
*   Branch hires640: the text bitmap is a 640x240 plane at 4 bits a dot
*   (gfx.a BmHi, CLUT 1, the lines' 16 colours), so glyphs are drawn at
*   640 with 1-dot strokes (glyphs.a from tools/glyphs.py --hires): an
*   entry's column is in 640ths (avg.a AVTX64: round(2x) from the beam's
*   fraction; doubling the 320 column let characters touch), and each dot
*   is a nibble, the left one high.  HIRES = 0 needs main's text.a and glyphs.a back.
********************************************************************

TXLIST              equ       $1800               in window A (avg.a)
GL.X                equ       0                   glyphs.a: a mask's record, 15 bytes a glyph and size
GL.Y                equ       1
GL.W                equ       2
GL.H                equ       3
GL.ROWS             equ       4                   up to 11 rows, 2 bytes each, the leftmost dot bit 15
GL.LEN              equ       26

********************************************************************
* TxCommit - draw the changes since the last frame's text
*
*   TxMatch first flags which entries changed, old (TXFO) and new
*   (TXFN), a bit an entry.  It matches the lists in order with a short
*   look-ahead, not index for index: the high score screen's top line
*   alternates between an 11- and an 8-character message, and by index
*   every entry after it then differed, so the whole table was erased
*   and redrawn every two seconds (0.6 s of it, on the K2).
********************************************************************
TxCommit            lbsr      TxMatch             Z = 1: nothing changed (Draw left room for it)
                    lbeq      tcx                 (then the lists are the same: no copy either)
                    ldd       #TXMUS
                    ldx       #GLYUS+11*ROWUS     room for the biggest glyph?
                    lbsr      Spend
                    clr       TXERS,u             nothing erased yet (ROWMSK is cleared at the first)
* pass 1: erase what changed
                    clr       TXCLR,u             erasing
                    leay      TXOLD,u             Y = the old
                    ldd       #0
tc1                 cmpd      TXCNT,u             every old entry
                    bhs       tc3a
                    pshs      d
                    leax      TXFO,u
                    lbsr      FlagAt
                    anda      ,x
                    beq       tc2a
                    tst       TXERS,u
                    bne       tc2b
                    inc       TXERS,u             the first erase: no rows marked yet
                    leax      ROWMSK,u
                    ldb       #30
tc0                 clr       ,x+
                    decb
                    bne       tc0
tc2b                tfr       y,x
                    lbsr      TxDraw              the old entry in 0
                    lbsr      TxSpnd
tc2a                leay      6,y
                    puls      d
                    addd      #1
                    bra       tc1
* pass 2: draw what changed, and what an erase may have touched
tc3a                ldx       VWIN,u
                    leax      TXLIST,x
                    ldd       #0
tc4                 cmpd      AVGPG+AV.TCNT,u     every new entry
                    bhs       tc7
                    pshs      d
                    pshs      x                   (on top: puls x takes it back alone)
                    leax      TXFN,u
                    lbsr      FlagAt
                    anda      ,x
                    puls      x
                    bne       tc5                 changed: draw
                    tst       TXERS,u             unchanged: nothing erased, nothing to redraw
                    beq       tc6
                    lbsr      TxMarked            on a marked row?
                    beq       tc6
tc5                 lda       1,x                 its colour << 4 | intensity: the nibble colour + 1,
                    lsra                          as the lines' (gfx.a AvgFlush), on CLUT 1
                    lsra
                    lsra
                    lsra
                    inca
                    cmpa      #16
                    blo       tc5a
                    lda       #15
tc5a                sta       TXCLR,u
                    lbsr      TxDraw
                    lbsr      TxSpnd
tc6                 leax      6,x
                    puls      d
                    addd      #1
                    bra       tc4
* the new list is now the old
tc7                 ldd       AVGPG+AV.TCNT,u
                    std       TXCNT,u
                    beq       tcx
                    lda       #6
                    mul                           D = bytes (256 entries at most: B's count x 6
                    tfr       d,y                 fits, and a count of 256 has B = 0...)
                    ldd       AVGPG+AV.TCNT,u
                    cmpd      #256
                    blo       tc8
                    ldy       #256*6
tc8                 ldx       VWIN,u
                    leax      TXLIST,x
                    pshs      u
                    leau      TXOLD,u
tc9                 lda       ,x+
                    sta       ,u+
                    leay      -1,y
                    bne       tc9
                    puls      u
tcx                 rts

********************************************************************
* TxMatch - TXFO and TXFN: a bit set for each old and new entry that
*   changed.  Walk both lists (TXI old, TXJ new): equal entries match;
*   otherwise look up to TXLOOK entries ahead in the new list for the
*   old one (the new ones before it were inserted) and in the old list
*   for the new one (the old ones before it were removed), and take the
*   nearer; neither: both changed.  What is left of either list at the
*   end changed.  Z = 1 when nothing did.  U kept.
********************************************************************
TXLOOK              equ       8

TxMatch             leax      TXFO,u              both flag arrays clear (TXFN follows TXFO)
                    ldb       #64
tqc                 clr       ,x+
                    decb
                    bne       tqc
                    clr       TXANY,u
                    ldd       #0
                    std       TXI,u
                    std       TXJ,u
tq1                 ldd       TXI,u
                    cmpd      TXCNT,u
                    lbhs      tqrn                the old list done: the rest of the new changed
                    ldd       TXJ,u
                    cmpd      AVGPG+AV.TCNT,u
                    lbhs      tqro                the new list done: the rest of the old changed
                    ldd       TXI,u
                    lbsr      OldAt               X = old[i]
                    ldd       TXJ,u
                    lbsr      NewAt               Y = new[j]
                    lbsr      TxSame
                    bne       tq2
                    ldd       TXI,u               the same: both on
                    addd      #1
                    std       TXI,u
                    ldd       TXJ,u
                    addd      #1
                    std       TXJ,u
                    bra       tq1
* old[i] ahead in the new list: k = 1.. while j + k < the new count
tq2                 ldb       #1
tq3                 cmpb      #TXLOOK
                    bhi       tq5                 not found
                    pshs      b
                    clra
                    addd      TXJ,u
                    cmpd      AVGPG+AV.TCNT,u
                    bhs       tq4                 past the end
                    lbsr      NewAt               Y = new[j + k]
                    lbsr      TxSame              (X is old[i] still)
                    puls      b
                    beq       tq6                 found at k
                    incb
                    bra       tq3
tq4                 puls      b
tq5                 ldb       #TXLOOK+1           k = none
tq6                 stb       TXK,u
* new[j] ahead in the old list: m = 1..
                    ldd       TXJ,u
                    lbsr      NewAt               Y = new[j]
                    ldb       #1
tq7                 cmpb      TXK,u               no nearer than k: not worth looking
                    bhs       tq9
                    pshs      b
                    clra
                    addd      TXI,u
                    cmpd      TXCNT,u
                    bhs       tq8
                    lbsr      OldAt               X = old[i + m]
                    lbsr      TxSame
                    puls      b
                    beq       tqrm                found at m < k: old i..i+m-1 were removed
                    incb
                    bra       tq7
tq8                 puls      b
tq9                 ldb       TXK,u
                    cmpb      #TXLOOK
                    bls       tqin                found at k: new j..j+k-1 were inserted
* neither: old[i] and new[j] both changed
                    ldd       TXI,u
                    leax      TXFO,u
                    lbsr      FlagSet
                    addd      #1
                    std       TXI,u
                    ldd       TXJ,u
                    leax      TXFN,u
                    lbsr      FlagSet
                    addd      #1
                    std       TXJ,u
                    lbra      tq1
tqin                ldd       TXJ,u               B = k: flag k new entries
                    leax      TXFN,u
tqin1               lbsr      FlagSet
                    addd      #1
                    dec       TXK,u
                    bne       tqin1
                    std       TXJ,u
                    lbra      tq1
tqrm                stb       TXK,u               m old entries
                    ldd       TXI,u
                    leax      TXFO,u
tqrm1               lbsr      FlagSet
                    addd      #1
                    dec       TXK,u
                    bne       tqrm1
                    std       TXI,u
                    lbra      tq1
tqro                ldd       TXI,u               the rest of the old
                    leax      TXFO,u
tqro1               cmpd      TXCNT,u
                    bhs       tqx
                    lbsr      FlagSet
                    addd      #1
                    bra       tqro1
tqrn                ldd       TXJ,u               the rest of the new
                    leax      TXFN,u
tqrn1               cmpd      AVGPG+AV.TCNT,u
                    bhs       tqx
                    lbsr      FlagSet
                    addd      #1
                    bra       tqrn1
tqx                 tst       TXANY,u
                    rts

* FlagSet - X = a flag array, D = an index (0-255): its bit set, TXANY too.  D, X kept.
FlagSet             pshs      d,x
                    bsr       FlagAt
                    ora       ,x
                    sta       ,x
                    lda       #1
                    sta       TXANY,u
                    puls      d,x,pc

* FlagAt - X = a flag array, D = an index (0-255): X = its byte, A = its bit.  B clobbered.
FlagAt              pshs      b
                    lsrb
                    lsrb
                    lsrb
                    abx
                    ldb       ,s+
                    andb      #7
                    lda       #1
fa1                 tstb
                    beq       fax
                    lsla
                    decb
                    bra       fa1
fax                 rts

* OldAt - D = an index: X = TXOLD's entry.  NewAt - Y = the new list's.  D clobbered.
OldAt               lda       #6
                    mul
                    leax      TXOLD,u
                    leax      d,x
                    rts
NewAt               lda       #6
                    mul
                    ldy       VWIN,u
                    leay      d,y
                    leay      TXLIST,y
                    rts

* TxSpnd - X = an entry just drawn: its cost to the pass's budget (frame.a Spend),
*   GLYUS and ROWUS a row.  All registers kept.
*   The list in window A and TXOLD stay as they are while the loop runs:
*   the game's next logic pass waits for this frame's drawing to end.
TxSpnd              pshs      d,x,y
                    lbsr      TxGlyph             its rows
                    lda       GL.H,y
                    ldb       #ROWUS
                    mul
                    addd      #GLYUS
                    ldx       #GLYUS+11*ROWUS     room for the biggest next?
                    lbsr      Spend
                    puls      d,x,y,pc

* TxSame - Z = 1 when the entries at X and Y are the same.  X, Y kept; D clobbered.
TxSame              ldd       ,x
                    cmpd      ,y
                    bne       tsx
                    ldd       2,x
                    cmpd      2,y
                    bne       tsx
                    ldd       4,x
                    cmpd      4,y
tsx                 rts

********************************************************************
* TxGlyph - X = an entry: Y = its glyph's mask record.  X kept.
********************************************************************
TxGlyph             ldb       ,x
                    andb      #$7F
                    lda       #GL.LEN*2
                    mul
                    leay      GlyTab,pcr
                    leay      d,y
                    tst       ,x
                    bpl       tgx
                    leay      GL.LEN,y            the big one follows the normal
tgx                 rts

********************************************************************
* TxMarked - X = an entry: Z = 0 when a row it covers is marked.  X, Y kept.
********************************************************************
TxMarked            pshs      x,y
                    bsr       TxGlyph
                    ldb       GL.H,y
                    beq       tmn                 a blank
                    lda       GL.Y,y              the first row: row + y (signed)
                    pshs      b                   ,s = rows left
                    ldb       GL.Y,y
                    sex
                    addd      4,x
tm1                 cmpd      #239                on the bitmap?
                    bhi       tm2                 (negative is above 239 unsigned)
                    pshs      d
                    lbsr      RowBit              X = the mask byte, A = the bit
                    anda      ,x
                    puls      d
                    bne       tmy
tm2                 addd      #1
                    dec       ,s
                    bne       tm1
                    leas      1,s
tmn                 orcc      #Zero
                    puls      x,y,pc
tmy                 leas      1,s
                    andcc     #^Zero
                    puls      x,y,pc

* RowBit - D = a row (0-239): X = its byte in ROWMSK, A = its bit.  U kept.
RowBit              pshs      b
                    lsrb
                    lsrb
                    lsrb
                    leax      ROWMSK,u
                    abx
                    ldb       ,s+
                    andb      #7
                    lda       #1
rb1                 tstb
                    beq       rbx
                    lsla
                    decb
                    bra       rb1
rbx                 rts

********************************************************************
* TxDraw - X = an entry: its mask in TXCLR (0 erases, and marks the
*   rows it touches).  X, Y, U kept.
*
*   The columns off the bitmap are the same on every row, so they are
*   cut once: TXSKP pixels dropped on the left, TXPIX drawn.  The first
*   visible row's place in the bitmap is worked out once (TxOff); each
*   row after it is 320 bytes on, into the next 8K block when it passes
*   one.  A row's pixels can cross a block boundary too (TxRun).
********************************************************************
TxDraw              pshs      x,y
                    lbsr      TxGlyph             Y = the mask record
                    lda       GL.H,y
                    lbeq      tdx                 a blank
                    sta       TXNR,u              rows left
                    leay      GL.ROWS,y
                    sty       TXGLY,u             the next row's bits
* the columns, in 640ths: first = column + x (avg.a writes 640ths, AVTX64); skip the ones left
* of 0, cut the ones right of 639
                    lda       TXCLR,u             the colour in both nibbles' places
                    lsla
                    lsla
                    lsla
                    lsla
                    sta       TXCLH,u
                    ldd       2,x
                    pshs      d
                    ldb       -GL.ROWS+GL.X,y
                    sex
                    addd      ,s++
                    clr       TXSKP,u
                    tsta
                    bpl       td2
td1                 inc       TXSKP,u             left of column 0
                    addd      #1
                    bmi       td1
td2                 std       TXCOL,u             the first column drawn
                    ldb       -GL.ROWS+GL.W,y
                    subb      TXSKP,u
                    lbls      tdx                 all of it left of the bitmap
                    stb       TXPIX,u
                    ldd       TXCOL,u
                    cmpd      #639
                    lbhi      tdx                 all of it right of the bitmap
                    addb      TXPIX,u             past column 640?
                    adca      #0
                    subd      #640
                    bls       td2a
                    negb
                    addb      TXPIX,u
                    stb       TXPIX,u
td2a                ldd       TXCOL,u             two dots a byte: the byte, and which half
                    andb      #1
                    stb       TXPAR,u             0 = the high nibble, the left dot
                    ldd       TXCOL,u
                    lsra
                    rorb
                    std       TXCOL,u             TXCOL is the byte column from here
* the rows: first = row + y; skip the ones above 0
td3                 ldb       -GL.ROWS+GL.Y,y
                    sex
                    addd      4,x
td4                 tsta
                    bpl       td5
                    addd      #1                  above row 0
                    ldx       TXGLY,u
                    leax      2,x
                    stx       TXGLY,u
                    dec       TXNR,u
                    bne       td4
                    bra       tdx
td5                 std       TXROW,u
                    cmpd      #239
                    bhi       tdx                 all of it below the bitmap
                    lbsr      TxOff               X = the offset in the block, A = the block
                    stx       TXROFS,u
                    sta       TXBK,u
td6                 tst       TXCLR,u
                    bne       td7
                    ldd       TXROW,u             erasing: mark the row
                    lbsr      RowBit
                    ora       ,x
                    sta       ,x
td7                 lbsr      TxRun               this row
                    ldx       TXGLY,u
                    leax      2,x
                    stx       TXGLY,u
                    ldd       TXROW,u
                    addd      #1
                    std       TXROW,u
                    cmpd      #239
                    bhi       tdx                 the rest is below the bitmap
                    ldd       TXROFS,u             the next row: 320 on
                    addd      #320
                    cmpd      #$2000
                    blo       td8
                    subd      #$2000
                    inc       TXBK,u
td8                 std       TXROFS,u
                    dec       TXNR,u
                    bne       td6
tdx                 puls      x,y,pc

* TxRun - one row: the 16 bits at TXGLY shifted past TXSKP, TXPIX dots
*   from block TXBK, offset TXROFS, the first in the half TXPAR says; a
*   dot set writes its nibble, TXCLR (right) or TXCLH (left)
TxRun               ldd       [TXGLY,u]
                    pshs      d                   ,s = the bits
                    ldb       TXSKP,u
                    beq       tr2
tr1                 lsl       1,s
                    rol       ,s
                    decb
                    bne       tr1
tr2                 lda       TXPIX,u
                    ldb       TXPAR,u
                    pshs      a,b                 ,s = dots left, 1,s = the half, 2,s = the bits
                    lda       TXBK,u
                    adda      TXBLK,u
                    leax      SWIN,u
                    lbsr      Map1                D = the block's logical address
                    bcs       trx
                    tfr       d,y
                    leay      $2000,y             Y = its end
                    addd      TXROFS,u
                    tfr       d,x                 X = the first dot's byte
tr3                 lsl       3,s
                    rol       2,s
                    bcc       tr4
                    lda       ,x
                    tst       1,s
                    bne       tr3r
                    anda      #$0F                the left dot
                    ora       TXCLH,u
                    bra       tr3w
tr3r                anda      #$F0                the right
                    ora       TXCLR,u
tr3w                sta       ,x
tr4                 dec       ,s
                    beq       trx
                    lda       1,s
                    eora      #1
                    sta       1,s
                    bne       tr3                 now the right half: the same byte
                    leax      1,x
                    pshs      y                   at the block's end?
                    cmpx      ,s++
                    blo       tr3
                    lda       TXBK,u              the row goes on in the next block
                    inca
                    adda      TXBLK,u
                    leax      SWIN,u
                    lbsr      Map1
                    bcs       trx
                    tfr       d,x
                    tfr       d,y
                    leay      $2000,y
                    bra       tr3
trx                 leas      4,s
                    rts

* TxOff - TXROW (0-239), TXCOL (0-319): X = the pixel's offset in its
*   block, A = the block (0-9) in the bitmap
TxOff               ldb       TXROW+1,u           the row
                    lda       #5
                    mul                           D = row * 5
                    clr       ,-s                 ,s = bits 23-16 of row * 320
                    lslb
                    rola
                    rol       ,s
                    lslb
                    rola
                    rol       ,s
                    lslb
                    rola
                    rol       ,s
                    lslb
                    rola
                    rol       ,s
                    lslb
                    rola
                    rol       ,s
                    lslb
                    rola
                    rol       ,s                  ,s:D = row * 320
                    addd      TXCOL,u             + the column
                    bcc       to1
                    inc       ,s
to1                 pshs      a                   ,s = bits 15-8, 1,s = bits 23-16
                    anda      #$1F
                    tfr       d,x                 X = the offset in the block
                    lda       ,s+                 bits 15-8
                    lsra
                    lsra
                    lsra
                    lsra
                    lsra
                    pshs      a
                    lda       1,s
                    lsla
                    lsla
                    lsla
                    ora       ,s+                 the block: bits 23-13
                    leas      1,s
                    rts
