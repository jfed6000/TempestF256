********************************************************************
* frame.a - the frame loop: the arcade's IRQ and MAINLN on the 60 Hz
*   tick (docs/port-plan.md section 2, decision D7).
*
*   THE CLOCK IS SOLdrv's (platform.a SolOn): a signal at line 0 of
*   every frame counts TICKS, and each pass runs the virtual IRQs of the
*   ticks since the last: the arcade's IRQ is 12.096 MHz / 4096 / 12 =
*   246.09375 Hz, exactly 525/128 of the tick, so a tick adds 525 to
*   VACC and a virtual IRQ (VirIRQ: the input shadows, then ALHAR2's
*   IRQ, which runs MOOLAH, MODSND and FRTIMR) runs for each 128 it
*   holds.  A pass that runs long is caught up, not lost, as the
*   arcade's IRQ keeps real time whatever its AVG does.  (Without /fSOL:
*   one pass a tick, F$Sleep X=2, and a long pass loses its ticks.)
*
*   A GAME FRAME IS TWO PASSES.  When FRTIMR reaches 9 (the arcade's
*   MAINLN rule), a pass runs the game's logic (GamLog: the clear armed,
*   EXSTAT, NONSTA, DISPLA); the next pass draws it whole (Draw: AvgRun
*   into the hidden bitmap, the flip, the CLUT, the text).  The drawing
*   is never split: with the clock caught up, splitting only cost frames
*   (docs/status.md, "The SOL clock").  It always comes a tick after the
*   clear was armed, which by then has run.  A drawing SKIPT ticks or
*   longer drops the next frame's drawing (the attract logo).
********************************************************************

VIRQN               equ       525                 virtual IRQs a tick, times VIRQD
VIRQD               equ       128
TKMAX               equ       32                  ticks a pass catches up at most (a superzapper blast: ~15)
SKIPT               equ       5                   a drawing this many ticks long drops the next one
                    ifndef    HIRES
HIRES               equ       1                   the line bitmaps 640x240 (gfx.a; branch hires640)
                    endc
AVCOLL              equ       1                   small shapes collapsed (avg.a AvShp; status.md "Small shapes collapsed")
AVWELL              equ       1                   the well drawn once into the back layer (gfx.a WellCom)
LOGOQK              equ       1                   the logo's quiet end shortened (alsco2.a LOGPRO): the
LOGMS               equ       4                   trail closes 4 a frame once the front arrives (Atari: 1),
LOGHD               equ       27                  and the merged logo holds 27 game frames (~1 s) at most
                    ifndef    LOGSKP
LOGSKP              equ       2                   every other copy of the attract logo not drawn (avg.a)
                    endc

* The clock (platform.a SolOn): with SOLdrv, a signal at line 0 of every
*   frame counts TICKS, and a pass runs the virtual IRQs of every tick
*   since the last (TKMAX at most): a pass that ran long is caught up,
*   not lost, as the arcade's IRQ keeps real time whatever the AVG does.
*   Without it, one pass a tick, as before (F$Sleep X=2).
MainLoop            tst       SOLPTH,u
                    beq       mlt
mls                 ldd       TICKS,u             the ticks since the last pass
                    std       TKNOW,u
                    subd      TSEEN,u
                    bne       mln
                    ldx       #0                  none yet: sleep until a signal
                    os9       F$Sleep
                    tst       SIGCODE,u
                    lbne      Done
                    bra       mls
mln                 cmpd      #TKMAX
                    bls       mlk
                    ldd       #TKMAX              (a long stall: not all of it)
mlk                 stb       TKN,u
                    ldd       TKNOW,u
                    std       TSEEN,u
                    bra       mlp
mlt                 ldx       #2                  wait for the next tick (X = 1 only gives up the time slice)
                    os9       F$Sleep
                    lda       #1
                    sta       TKN,u
mlp                 ldd       PASSES,u            (the sign-off reports them)
                    addd      #1
                    std       PASSES,u
                    tst       SIGCODE,u
                    lbne      Done
                    tst       PAUSED,u
                    lbne      PausWt
                    ldb       TKN,u               the ticks
                    lbsr      InFram              the keys, the stick, the mouse (input.a)
                    tst       QUITKEY,u
                    lbne      Done
                    ldb       TKN,u               the virtual IRQs those ticks owe
mlv                 ldx       VACC,u
                    leax      VIRQN,x
                    stx       VACC,u
                    decb
                    bne       mlv
ml1                 ldd       VACC,u
                    subd      #VIRQD
                    blo       ml2
                    std       VACC,u
                    lbsr      VirIRQ
                    bra       ml1
ml2                 lbsr      SndOut              the POKEY image onto the SIDs (sound.a)
                    tst       DRPEND,u            a frame's logic ran in an earlier pass: draw it
                    bne       mld
                    lda       <FRTIMR             the arcade's MAINLN: a game frame once 9 have run
                    cmpa      #9
                    lblo      MainLoop
                    lbsr      GamLog
                    ldd       GFRAMS,u            (the game's frames: its pace, drawn or not)
                    addd      #1
                    std       GFRAMS,u
                    tst       SKIPNX,u            the last drawing ran long: this frame is not drawn
                    beq       mlq
                    clr       SKIPNX,u
                    ldd       DROPS,u
                    addd      #1
                    std       DROPS,u
                    ifdef     AVWELL
                    clr       AVGPG+AV.CVAL,u     (the well may be rebuilt twice unseen: its cache goes)
                    endc
                    lbra      MainLoop
mlq                 inc       DRPEND,u            drawn in the next pass, a tick on: the clear has run
                    lbra      MainLoop
mld                 clr       DRPEND,u
                    ldd       TICKS,u
                    std       DRWT0,u
                    bsr       Draw
DrwEnd              ldd       TICKS,u             the frame is drawn (tools/osrun.py checks it here)
                    subd      DRWT0,u             SKIPT ticks or more: the next frame's drawing is
                    cmpd      #SKIPT              dropped, so the game keeps closer to its pace
                    blo       mlx                 (the attract logo: 19 copies, ~6 ticks a drawing)
                    inc       SKIPNX,u
mlx                 lbra      MainLoop

********************************************************************
* GamLog - a game frame's logic: MAINLN's three calls.  The hidden line
*   bitmap's clear is armed first (BmArm): the DMA engine runs it in
*   the next vertical blank, with the CPU halted until it is done, so
*   the drawing, a pass (a tick) later, finds it clear without asking
*   (BmWait's GetStat went, docs/status.md).  Waiting for it here cost
*   the rest of the tick (docs/port-plan.md D9).
********************************************************************
GamLog              clr       <FRTIMR             ALEXEC:53 LDA I,0 / STA FRTIMR
                    lda       SHOWN,u
                    eora      #1
                    lbsr      BmArm               the hidden line bitmap, cleared in the next blank
                    lbsr      EXSTAT              ALEXEC:55-57
                    lbsr      NONSTA
                    lbra      DISPLA

* Draw - the list into the hidden bitmap, shown; then the colours and the
*   text, which are single-buffered.  In one pass.
Draw
                    ifdef     AVWELL
                    lda       #1                  the well's records captured (avg.a)
                    sta       AVGPG+AV.WENA,u
                    endc
                    lbsr      AvgRun              records to AvgFlush (gfx.a), in batches of 255
                    ifdef     AVWELL
                    lbsr      WellCom             the well: the back layer, or with the lines (gfx.a)
                    endc
                    lbsr      Flip
                    lbsr      ClutCommit
                    lbra      TxCommit

********************************************************************
* VirIRQ - one virtual IRQ: the switches into the shadows the IRQ reads
*   (the arcade's levels and polarities, from MAME's tempest.cpp and the
*   captures), then the IRQ itself (alhar2.a).
*     HW_60C8 ALLPOT: low 4 bits the encoder counter, inverted; bit 4 0
*             = upright; bit 5 0 (option switch MOPTI4 off)
*     HW_60D8 ALLPO2: bit 3 superzapper, 4 fire, 5 start 1, 6 start 2,
*             1 = pressed; bits 0-2 the special options (0)
*     HW_0C00 IN1: active low: coins (bit 2 the left, the coin key),
*             slam, test, diagnostic step all open; bit 6 1 = the vector
*             generator is halted, which the port's always is between
*             frames (AvgRun finishes before the next logic pass)
*   The encoder moves at most 7 counts a virtual IRQ (the IRQ reads a
*   4-bit difference); the rest waits in KNBPND for the next.
********************************************************************
VirIRQ              ldd       KNBPND,u
                    bmi       vi1
                    cmpd      #7
                    bls       vi2
                    ldd       #7
                    bra       vi2
vi1                 cmpd      #-7
                    bge       vi2
                    ldd       #-7
vi2                 pshs      b
                    addb      KNOB,u
                    stb       KNOB,u
                    comb
                    andb      #$0F
                    stb       HW_60C8,u
                    ldb       ,s+
                    sex
                    pshs      d
                    ldd       KNBPND,u
                    subd      ,s++
                    std       KNBPND,u
                    lda       BUTTNS,u
                    sta       HW_60D8,u
                    lda       #$7F                IN1 at rest
                    tst       COINTM,u
                    beq       vi3
                    dec       COINTM,u
                    anda      #^$04               the left coin mech closed
vi3                 sta       HW_0C00,u
                    lbra      IRQ

********************************************************************
* GamInit - the arcade's RESET (ALTES2:238-296) less its self-test,
*   then MAINLN's start (ALEXEC:45-47).  RAM and vector RAM are clear
*   already.  The EAROM is not read (REHIIN): the high scores are the
*   game's defaults until the settings file (plan stage 7f).
********************************************************************
GamInit             lda       #$7F                the switches at rest (VirIRQ)
                    sta       HW_0C00,u
                    lda       #$0F
                    sta       HW_60C8,u
                    clr       HW_60D8,u
                    clr       HW_0D00,u           the option switches: MAME's defaults (the
                    clr       HW_0E00,u           settings file sets them, stage 7f)
                    lda       #$10                ALTES2:290 LDA I,MVINVY / STA TOUT0
                    sta       <TOUT0
                    lbsr      INIINI              ALTES2:293
                    lbsr      INIDSP              ALTES2:294
                    lbsr      INISOU              ALEXEC:45
                    clr       <QSTATE             ALEXEC:46-47 CNEWGA
                    rts
