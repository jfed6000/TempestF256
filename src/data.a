********************************************************************
* data.a - the data area (8K, one block).  U = its base and DP = its
* page for the whole run (OS-9 gives both at start; page-aligned).
*
*   $0000-$07FF  the arcade's 2K of RAM, page for page (arcade.d)
*   $0800-$08FF  the port's game variables: POKIMG, VWIN, CLRSHD, RNDST
*   $0900-$09FF  HWSHAD, the hardware shadows (port.d; the EAROM's
*                indexed writes land up to HWSHAD+$29, still inside)
*   $0A00-$0B9D  RELTAB, reloc.a's tables
*   $0C00-$0CFF  AVGPG, the AVG interpreter's page (avg.a)
*   $0D00-       the platform's, below
*   $1C00-$1FFF  the stack (1K), and OS-9's parameter copy above it
********************************************************************

DatBeg              rmb       $0D00               the game's and the interpreter's (port.d, arcade.d)
TXOLD               rmb       256*6               the text list last drawn (text.a TxCommit)
CLUTBF              rmb       256*4               SS.ClutWrite entries, B,G,R,A (gfx.a ClutCommit)

* windows: W.Blk the block mapped (0 = none), W.Log its logical address
W.Blk               equ       0
W.Log               equ       1
W.Len               equ       3
AWIN                rmb       W.Len               window A: vector RAM, the record batch, the text list
SWIN                rmb       W.Len               the service window (text bitmap rows; Map1)
AWBLK               rmb       1                   window A's RAM block (F$AllRAM), 0 = none

* the display
BMOWN               rmb       1                   bit n: bitmap n allocated here (freed on exit)
SHOWN               rmb       1                   the line bitmap on layer 1 (0 or 1)
BMBLKS              rmb       3                   bitmaps 0-2: their first blocks (SS.BmBlk)
TXBLK               equ       BMBLKS+2            the text bitmap's
NODMA               rmb       1                   non-zero: SS.BmClear failed once; the CPU clears
MCRLO               rmb       1                   the display mode on entry, restored on exit
MCRHI               rmb       1
CLSENT              rmb       16                  colour RAM as last sent to the CLUT (ClutCommit)
TXCNT               rmb       2                   TXOLD's entries
ROWMSK              rmb       30                  text.a: the rows an erase touched, a bit a row
TXCLR               rmb       1                   text.a: the colour being drawn (0 = erasing)
TXERS               rmb       1                   text.a: non-zero once this frame erased (ROWMSK valid)
TXFO                rmb       32                  text.a TxMatch: the old entries that changed, a bit each
TXFN                rmb       32                  the new ones (must follow TXFO)
TXI                 rmb       2                   TxMatch: the old list's place
TXJ                 rmb       2                   the new list's
TXK                 rmb       1                   a look-ahead's distance
TXANY               rmb       1                   non-zero: something changed
TXROW               rmb       2                   text.a: scratch
TXCOL               rmb       2
TXGLY               rmb       2
TXROFS               rmb       2                   text.a: the row's offset in its block
TXBK                rmb       1                   text.a: the row's block in the bitmap
TXSKP               rmb       1                   text.a: pixels cut on the left
TXPIX               rmb       1                   text.a: pixels drawn a row
TXPAR               rmb       1                   text.a: the first dot's half of its byte (0 = left, high)
TXCLH               rmb       1                   text.a: TXCLR << 4, the left dot's nibble
TXNR                rmb       1                   text.a: rows left
FLSHN               rmb       1                   AvgFlush: tries left while the FIFO is full

* sound (sound.a): the SIDs' six voices and the POKEYs' eight channels
SNDVCH              rmb       6                   a voice's channel ($FF: free); SNDCHV must follow
SNDCHV              rmb       8                   a channel's voice ($FF: none)
SNDVC               rmb       6                   a voice's control register as written; SNDVS, SNDVF follow
SNDVS               rmb       6                   its sustain/release register as written
SNDVF               rmb       12                  its frequency as written (high, low)
SNDUP               rmb       1                   non-zero: SndInit ran (SndExit silences)
SNDBAS              rmb       2                   SndOut: the left SID's logical address
SNDCH               rmb       1                   SndOut: the channel
SNDV                rmb       1                   SndOut: its voice
SNDSR               rmb       1                   SndOut: the sustain/release wanted
SNDF                rmb       2                   SndOut: the frequency wanted
SNDCT               rmb       1                   SndOut: the control register wanted
SNDCC               rmb       1                   SidOn: CC as found (the interrupt mask)
SNDF0               rmb       1                   SidOn: the MMU's control register as found
SNDSL               rmb       1                   SidOn: window A's slot
SNDOB               rmb       1                   SidOn: the block it held
TSMODE              rmb       1                   the first character of the parameters ('s': tsnd)
TSRUN               rmb       1                   tsnd: the sequence is playing
TSSEQ               rmb       1                   tsnd: its next step (offset in TsSeq)
TSTIM               rmb       1                   tsnd: ticks left in this step
TSKEY               rmb       1                   tsnd: the key read
GFXON               rmb       1                   non-zero: GfxInit ran (GfxExit undoes it)

* the line sends (gfx.a BmSend) and the well (WellCom)
BSBM                rmb       1                   BmSend: the bitmap
WLST                rmb       1                   non-zero: the well is in the back layer (WLOLD as drawn)
WLSTB               rmb       1                   frames its geometry has held, with the lines
WLON                rmb       1                   WLOLD's records
WLN                 rmb       1                   this frame's (AV.WNC)
WLSAM               rmb       1                   non-zero: this frame's geometry is WLOLD's
WLK                 rmb       1                   scratch: records picked
WLI                 rmb       1                   scratch: records left
WLT                 rmb       1                   scratch
WLE0                rmb       1                   WlRows: the first row erased
WLE1                rmb       1                   and the last
WLNEW               rmb       2                   window A + $1E00: this frame's well (avg.a)
WLDST               rmb       2                   scratch: where the next picked record goes
TXALL               rmb       1                   non-zero: TxCommit draws every entry again
WLDONE              rmb       1                   non-zero: AvgLast added the well's off-colour records to the batch
WLOLD               rmb       56*8                the well as last seen (avg.a WMAX records)

* the frame loop
DRPEND              rmb       1                   non-zero: a frame's logic ran; the next pass draws it
DRWT0               rmb       2                   TICKS when this frame's drawing began
VACC                rmb       2                   the virtual IRQ's Bresenham accumulator (frame.a)
GFRAMS              rmb       2                   game frames run (their logic; drawn or dropped)
DROPS               rmb       2                   drawings dropped (the sign-off)
SKIPNX              rmb       1                   non-zero: the next frame's drawing is dropped
PAUSED              rmb       1                   non-zero = our terminal is a shadow (SS.WSig S$WinBg)
SOLPTH              rmb       1                   SOLdrv's path (0: none; one pass a tick)
TICKS               rmb       2                   ticks counted by the signal (Icpt)
TSEEN               rmb       2                   TICKS as the last pass took them
TKNOW               rmb       2                   TICKS read this pass
TKN                 rmb       1                   the ticks this pass runs (1-TKMAX)
SIGCODE             rmb       1                   abort/interrupt signal received (0 = none)

* input (input.a)
KNOB                rmb       1                   the emulated encoder counter (low 4 bits)
KNBPND              rmb       2                   counts not yet given to a virtual IRQ (signed)
BUTTNS              rmb       1                   ALLPO2's active-high buttons (zap, fire, starts)
COINTM              rmb       1                   virtual IRQs the coin switch stays closed
MOUSE               rmb       1                   non-zero: SS.MsDelta answers (counts mode set)
JOYON               rmb       1                   non-zero: stick 0 has been used (read every pass)
JOYCNT              rmb       1                   passes to the next look while it has not
KBLAST              rmb       6                   last pass's held keys (new-press detection)
QUITKEY             rmb       1                   Q was pressed
EXITST              rmb       1                   exit status, for the sign-off
OPTSAV              rmb       32                  path 0's options as found (Cleanup puts them back)
OPTNEW              rmb       32                  the same, with echo and the signal characters off
OPTOK               rmb       1                   OPTSAV holds a real packet
TIMBUF              rmb       6                   F$Time's packet (the RANDOM seed)
T0BUF               rmb       6                   F$Time at the first pass (the sign-off's numbers)
PASSES              rmb       2                   passes of the frame loop (one a tick, if none ran long)
STLINE              rmb       48                  the sign-off's numbers, as text
LNCALL              rmb       2                   SS.BmLine calls (gfx.a BmSend), for the sign-off
LNSHRT              rmb       2                   of them, returned short: the line FIFO's room ran out

StkBase             equ       $1C00               the stack: the top 1K (as Joust), with OS-9's parameters
                    ifgt      .-StkBase
                    error     data area overflow
                    endc
                    rmb       $2000-.
size                equ       .
