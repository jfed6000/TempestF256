	fcb	$3E,$44,$00,$2C,$16,$30,$1A,$1E
	fcb	$BA,$96,$3A,$34,$26,$3C,$48,$1E
	fcb	$30,$00,$16,$3E,$3A,$42,$1E,$26
	fcb	$1A,$24,$1E,$B0,$A0,$1E,$40,$26
	fcb	$3C,$1E,$00,$2C,$16,$3A,$00,$34
	fcb	$3E,$30,$3C,$16,$BA,$E0,$2C,$1E
	fcb	$40,$1E,$AC,$DA,$30,$26,$40,$1E
	fcb	$16,$BE,$E2,$22,$38,$16,$9C,$E0
	fcb	$30,$26,$40,$1E,$AC,$C4,$3A,$3E
	fcb	$34,$1E,$38,$48,$16,$34,$34,$1E
	fcb	$38,$00,$38,$1E,$1A,$24,$16,$38
	fcb	$22,$9E,$CD,$30,$1E,$3E,$1E,$38
	fcb	$00,$3A,$3E,$34,$1E,$38,$48,$16
	fcb	$34,$34,$1E,$B8,$CD,$30,$3E,$1E
	fcb	$40,$32,$00,$3A,$3E,$34,$1E,$38
	fcb	$48,$16,$34,$34,$1E,$B8
* LNGTAB: the four message tables' copies (reloc.a), as data-area offsets
LNGTAB
	fdb	R.MSG			ALLANG:253 LNGTAB: .WORD ENGMSG
	fdb	R.MSG+60		ALLANG:254 .WORD FREMSG
	fdb	R.MSG+120		ALLANG:255 .WORD GERMSG
	fdb	R.MSG+180		ALLANG:256 .WORD SPAMSG
INILIT
* HAND: hardware register (ALLANG:259 LDA INOP1  ;SET UP BONUS LIFE INTERVAL)
	lda	HW_0E00,u			ALLANG:259 LDA INOP1  ;SET UP BONUS LIFE INTERVAL
	sta	<OPTIN2			ALLANG:260 STA OPTIN2
	anda	#$38			ALLANG:261 AND I,38
	lsra			ALLANG:262 LSR
	lsra			ALLANG:263 LSR
	lsra			ALLANG:264 LSR
	sta	<RX			ALLANG:265 TAX
	leax	TBLIFI,pcr			ROM table + X
	ldb	<RX
	abx
	lda	0,x			ALLANG:266 LDA X,TBLIFI
	sta	BLIFIN,u			ALLANG:267 STA BLIFIN
* HAND: hardware register (ALLANG:268 LDA INOP0  ;READ OPTION SWITCHES)
	lda	HW_0D00,u			ALLANG:268 LDA INOP0  ;READ OPTION SWITCHES
	eora	#$02			ALLANG:269 EOR I,2
	sta	<_SCMODE			ALLANG:270 STA $CMODE
	lda	<OPTIN2			ALLANG:271 LDA OPTIN2  ;LIVES/GAME
	rola			ALLANG:272 ROL
	rola			ALLANG:273 ROL
	rola			ALLANG:274 ROL
	anda	#$03			ALLANG:275 AND I,3
	sta	<RX			ALLANG:276 TAX
	leax	GAMLVS,pcr			ROM table + X
	ldb	<RX
	abx
	lda	0,x			ALLANG:277 LDA X,GAMLVS
	sta	LVSGAM,u			ALLANG:278 STA LVSGAM
	lda	<OPTIN2			ALLANG:279 LDA OPTIN2  ;LANGUAGE CHOICE
	anda	#$06			ALLANG:280 AND I,06
	sta	<RY			ALLANG:281 TAY
	ldx	<RYP			data base + Y: LNGTAB's copy (reloc.a)
	lda	R.LNG,x			ALLANG:282 LDA Y,LNGTAB  ;SET POINTER TO LANGUAGE PTRS.
	sta	<LITRAL+1			ALLANG:283 STA LITRAL
	lda	R.LNG+1,x			ALLANG:284 LDA Y,LNGTAB+1
	sta	<LITRAL			ALLANG:285 STA LITRAL+1
* (ALLANG:286) GETOP3 is translated (stubs.a); nothing after INILIT reads V.
	lbsr	GETOP3			ALLANG:286 JSR GETOP3
	sta	OPTIN3,u			ALLANG:287 STA OPTIN3
	rts			ALLANG:288 RTS
TBLIFI
	fcb	$02,$01,$03,$04,$05,$06,$07,$00		ALLANG:289 TBLIFI: .BYTE 2,1,3,4,5,6,7,0
GAMLVS
	fcb	$03,$04,$05,$02		ALLANG:290 GAMLVS: .BYTE 3,4,5,2

