* DIVQ - the Math Box's SZXD as WORSCR sets it up (N=15, dividend A*256, divisor Y):
* D = floor(A*128/Y) for Y = 1..$7FFF, and $FFFF for Y = 0 (exact against MAME's model over
* every input WORSCR can give it; docs/status.md).  Uses A, B, CC.
DIVQ	leay	,y			DY = 0: the Math Box answers $FFFF
	beq	_DQ0
	clrb				D = A*128
	lsra
	rorb
	pshs	cc			the unit is shared: masked for the sequence
	orcc	#$50
	sty	CP.DVSR
	std	CP.DVND
	ldd	CP.QUOT
	puls	cc,pc
_DQ0	ldd	#$FFFF
	rts

* DIVF - the Math Box's SZXD as CASCAL sets it up (N=24, dividend A*256, divisor Y signed):
* D = the low 16 bits of floor(A*65536/|Y|), negated when Y < 0, exact against MAME's model for
* A < $80 and |Y| >= 1 that is >= 54 or >= A (checked over every input; docs/status.md), which is
* all of play (|Y| >= YDEUNI there).  Two coprocessor divides, the second by shift-and-subtract
* when the first's remainder is 256 or more.  Everywhere else (an object nearer the eye than
* YDEUNI, as in the dive, or A >= $80) the Math Box's own overflowing loop, MBDV24.
* Uses X, Y.
DIVF	tsta
	bmi	MBDV24
	pshs	y,a			0,s A; 1,s the divisor, whose sign is the result's
	tfr	y,d
	tsta
	bpl	_DF1
	nega				D = |divisor| ($8000 stays $8000)
	negb
	sbca	#0
_DF1	cmpd	#54
	bhs	_DF7
	tstb				(A is 0 here)
	beq	_DFMB			a zero divisor
	cmpb	,s
	blo	_DFMB			|divisor| < 54 and < A: the Math Box overflows
_DF7	tfr	d,y
	lda	,s			D = A*256
	clrb
	pshs	cc			masked for the sequence
	orcc	#$50
	sty	CP.DVSR
	std	CP.DVND
	ldx	CP.QUOT			q1: its low byte is the result's high byte
	ldd	CP.REM			r1
	puls	cc
	tsta
	bne	_DF3			r1 >= 256: r1*256 does not fit 16 bits
	tfr	b,a			D = r1*256
	clrb
	pshs	cc
	orcc	#$50
	sty	CP.DVSR
	std	CP.DVND
	ldd	CP.QUOT			q2 < 256, in B
	puls	cc
_DF2	pshs	x
	lda	1,s			D = q1*256 + q2
	leas	2,s
	tst	1,s
	bpl	_DF5
	nega				the divisor was negative: so is the result
	negb
	sbca	#0
_DF5	leas	3,s
	rts
_DF3	pshs	y			0,s |divisor|; q2 = floor(r1*256/|divisor|), a bit at a time
	ldy	#$FE00			Y high byte: the quotient's complement, a 0 sentinel below it
_DF4	lslb				r1 < |divisor| <= $8000, so 2*r1 fits
	rola
	cmpd	,s
	blo	_DF6
	subd	,s			C clear: a 1 bit
_DF6	exg	d,y
	rola				C (the bit's complement) in; the sentinel out last
	exg	d,y
	bcs	_DF4
	leas	2,s
	exg	d,y
	coma
	tfr	a,b			q2
	bra	_DF2
_DFMB	lda	,s			back to A and the signed divisor
	ldy	1,s
	leas	3,s
* MBDV24 - MAME's Math Box divide (mathbox.cpp, step_0bf) with N=24, dividend high word A*256,
* low word 0, divisor Y: 25 steps of a 16-bit shift-and-subtract whose remainder overflows.
MBDV24	pshs	y			5,s the divisor (its sign is the result's)
	clrb
	pshs	d			3,s the quotient register, starting as the dividend's high word
	tfr	y,d
	tsta
	bpl	_MB1
	nega				|divisor|, 16-bit
	negb
	sbca	#0
_MB1	pshs	d			1,s |divisor|
	lda	#25
	pshs	a			0,s steps
	clra				D = the remainder register
	clrb
_MB2	subd	1,s
	bmi	_MB3
	lsl	4,s			C = the bit shifted out of the quotient
	rol	3,s
	inc	4,s			a 1 bit (INC leaves C)
	bra	_MB4
_MB3	addd	1,s
	lsl	4,s
	rol	3,s
_MB4	rolb				remainder*2 + the bit shifted out
	rola
	dec	,s
	bne	_MB2
	ldd	3,s
	tst	5,s
	bpl	_MB5
	nega
	negb
	sbca	#0
_MB5	leas	7,s
	rts
