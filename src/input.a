********************************************************************
* input.a - the controls (docs/port-plan.md D4) into what the arcade's
*   IRQ reads: encoder counts (KNBPND, handed to the virtual IRQs by
*   VirIRQ) and the ALLPO2 buttons (BUTTNS), plus the coin and Q.
*
*   Keyboard (SS.LiveKeys): left and right arrows turn at KEYRATE a
*   tick, Shift fires, z is the superzapper (lower case: the driver's
*   codes are unshifted), 1 and 2 are the start buttons, 5 drops a coin,
*   q quits.  Joystick 0 (SS.Joy JOY.Sticks): left and right at the same
*   rate, button 0 fires, button 2 zaps (the K2's core ties buttons 1 and
*   2 open, docs/status.md).  SNES pad 0 (SS.Joy JOY.SNES2): the same, its
*   low byte being stick-compatible: B fires, A zaps.  Mouse (SS.MsDelta $D0, when
*   the driver has it): X motion, one count a count; left button fires,
*   right zaps.  All of them together.
*
*   The direction (user, 2026-09-27): right turns the claw counter-
*   clockwise, so it moves right along the flat wells' rim at the bottom
*   (the first guess was backwards there), and the other way round in
*   the rating ladder and the initials (KnbRev).  The rate: KEYRATE 4.
********************************************************************

SS.MsDelta          equ       $D0                 approved (plan 6.1); not in the driver yet
KEYRATE             equ       4                   encoder counts a tick while a key or the stick is held
KNBMAX              equ       64                  counts owed at most, either way
COINLEN             equ       8                   virtual IRQs the coin switch stays closed (32 ms)
JOYLOOK             equ       30                  passes between looks at a stick not yet used
KY.Shift            equ       %00000001           SS.LiveKeys sense bits (D.KySns)
KY.Left             equ       %00100000
KY.Right            equ       %01000000
BT.Zap              equ       $08                 ALLPO2, active high
BT.Fire             equ       $10
BT.Start1           equ       $20
BT.Start2           equ       $40

********************************************************************
* InFram - B = the ticks since the last pass.  U = the data area.
********************************************************************
InFram              pshs      b                   ,s = ticks
                    clr       BUTTNS,u
                    clra                          path 0
                    ldb       #SS.LiveKeys
                    os9       I$GetStt            A = sense bits, X, Y, U = the six held keys
                    pshs      u,y,x,a,cc          ,s cc, 1,s sense, 2,s the six keys
                    tfr       dp,a                U back: the data area is DP's page
                    clrb
                    tfr       d,u
                    puls      cc
                    bcs       inkx                an older grfdrv256: no keyboard
                    lda       ,s                  the sense bits
                    bita      #KY.Left
                    beq       in1
                    ldb       7,s
                    lbsr      KnbUp
in1                 bita      #KY.Right
                    beq       in2
                    ldb       7,s
                    lbsr      KnbDn
in2                 bita      #KY.Shift
                    beq       in3
                    ldb       #BT.Fire
                    lbsr      BtnOn
in3                 leay      1,s                 the held keys
                    ldb       #6
in4                 lda       ,y+
                    beq       in6
                    pshs      b
                    ldb       #BT.Zap
                    cmpa      #'z
                    beq       in5
                    ldb       #BT.Start1
                    cmpa      #'1
                    beq       in5
                    ldb       #BT.Start2
                    cmpa      #'2
                    beq       in5
                    lbsr      KbNew               5 and q act on a new press
                    bra       in5x
in5                 lbsr      BtnOn
in5x                puls      b
in6                 decb
                    bne       in4
                    ldd       1,s                 remember this pass's keys
                    std       KBLAST,u
                    ldd       3,s
                    std       KBLAST+2,u
                    ldd       5,s
                    std       KBLAST+4,u
inkx                leas      7,s
* the stick: every pass once it has been used; before that, a look
* every JOYLOOK passes (an SS.Joy call a pass is ~400 us of every tick)
                    tst       JOYON,u
                    bne       ij0
                    dec       JOYCNT,u
                    bpl       injx
                    lda       #JOYLOOK-1
                    sta       JOYCNT,u
ij0                 lda       #0                  path 0
                    ldb       #SS.Joy
                    ldx       #JOY.Sticks         both sticks as bits; stick 0 is ours
                    os9       I$GetStt
                    bcs       injx                an older grfdrv256: no sticks
                    tfr       x,d
                    tstb
                    beq       injx                nothing pressed
                    lda       #1                  used: read it every pass from now on
                    sta       JOYON,u
                    tfr       b,a
                    ldb       ,s                  the ticks
                    bsr       JoyA
injx
* SNES pad 0, looked at the same way.  The port can't tell whether a pad
* is plugged in, and its first reading is empty, so PADST: the first
* reading is skipped (0 -> 1), then the pad must read all zero, at rest,
* once (1 -> 2) before its buttons count.  A port that reads held with
* no pad, or an NES pad (its missing A X L R read held), is never taken.
                    tst       PADON,u
                    bne       ip0
                    dec       PADCNT,u
                    bpl       ipx
                    lda       #JOYLOOK-1
                    sta       PADCNT,u
ip0                 lda       #0                  path 0
                    ldb       #SS.Joy
                    ldx       #JOY.SNES2          SNES pads 0 and 1: X = pad 0
                    os9       I$GetStt
                    bcs       ipx                 an older grfdrv256: no pads
                    ldb       PADST,u
                    cmpb      #2
                    beq       ip2
                    tstb
                    beq       ip1                 the first reading: empty whatever is held
                    cmpx      #0
                    bne       ipx                 held with nothing seen at rest: not yet
ip1                 inc       PADST,u
                    bra       ipx
ip2                 cmpx      #0
                    beq       ipx                 nothing pressed
                    lda       #1                  used: read it every pass from now on
                    sta       PADON,u
                    tfr       x,d
                    tfr       b,a                 the low byte, as a stick's
                    ldb       ,s                  the ticks
                    bsr       JoyA
ipx
* the mouse
                    tst       MOUSE,u
                    beq       inx
                    lda       #0
                    ldb       #SS.MsDelta
                    os9       I$GetStt            X = delta X, A = buttons
                    bcs       inx
                    bita      #%00000001
                    beq       im1
                    ldb       #BT.Fire
                    bsr       BtnOn
im1                 bita      #%00000010
                    beq       im2
                    ldb       #BT.Zap
                    bsr       BtnOn
im2                 tfr       x,d
                    addd      KNBPND,u
                    bsr       KnbSet
inx                 puls      b,pc

* JoyA - A = a stick's JY bits, or a pad's low byte; B = the ticks.  Left
*   and right turn at KEYRATE a tick, button 0 fires, button 2 zaps.
JoyA                pshs      b                   ,s = ticks
                    bita      #JY.Left
                    beq       ja1
                    ldb       ,s
                    bsr       KnbUp
ja1                 bita      #JY.Right
                    beq       ja2
                    ldb       ,s
                    bsr       KnbDn
ja2                 bita      #JY.Btn0
                    beq       ja3
                    ldb       #BT.Fire
                    bsr       BtnOn
ja3                 bita      #JY.Btn2
                    beq       ja4
                    ldb       #BT.Zap
                    bsr       BtnOn
ja4                 puls      b,pc

* BtnOn - B = an ALLPO2 bit: pressed.  A kept.
BtnOn               orb       BUTTNS,u
                    stb       BUTTNS,u
                    rts

* KnbUp / KnbDn - B = ticks: KEYRATE counts a tick one way or the other,
*   the other way round in the menus (KnbRev).  A kept.
KnbUp               pshs      a
                    bsr       KnbRev
                    bne       kd1                 a menu: down
ku1                 lda       #KEYRATE
                    mul
                    addd      KNBPND,u
                    bra       kn1
KnbDn               pshs      a
                    bsr       KnbRev
                    bne       ku1                 a menu: up
kd1                 lda       #KEYRATE
                    mul
                    pshs      d
                    ldd       KNBPND,u
                    subd      ,s++
kn1                 bsr       KnbSet
                    puls      a,pc

* KnbRev - NE in the menus.  There the game reads the counts through
*   GINICO, + for the next initial or rating (on screen, to the right):
*   the high score initials (GETINI, state $12) and the rating ladder
*   (PRORAT, $16).  Elsewhere + turns the claw clockwise, and the keys
*   are the other way round (right = counterclockwise).  A clobbered.
KnbRev              lda       <QSTATE
                    cmpa      #$12                GETINI (ALEXEC:94)
                    beq       kr1
                    cmpa      #$16                PRORAT (ALEXEC:96)
                    beq       kr1
                    clra                          EQ: the claw
                    rts
kr1                 lda       #1                  NE: a menu
                    rts

* KnbSet - KNBPND = D, held to +-KNBMAX.  A, B clobbered.
KnbSet              cmpd      #KNBMAX
                    ble       ks1
                    ldd       #KNBMAX
ks1                 cmpd      #-KNBMAX
                    bge       ks2
                    ldd       #-KNBMAX
ks2                 std       KNBPND,u
                    rts

* KbNew - A = a held key: 5 or q, when it was not held last pass, act on it.  B, Y kept.
KbNew               leax      KBLAST,u
                    pshs      b
                    ldb       #6
kw1                 cmpa      ,x+                 held last pass too?
                    beq       kwx
                    decb
                    bne       kw1
                    cmpa      #'5
                    bne       kw2
                    lda       #COINLEN            a coin, closed for COINLEN virtual IRQs
                    sta       COINTM,u
                    bra       kwx
kw2                 cmpa      #'q
                    bne       kwx
                    inc       QUITKEY,u
kwx                 puls      b,pc

********************************************************************
* InInit / InExit - the mouse into counts mode for the run, and back to
*   the pointer.  A driver without SS.MsDelta refuses: no mouse.
********************************************************************
InInit              clr       MOUSE,u
                    lda       #0
                    ldb       #SS.MsDelta
                    ldx       #1                  counts mode
                    os9       I$SetStt
                    bcs       iix
                    inc       MOUSE,u
                    lda       #0                  the motion so far is not ours
                    ldb       #SS.MsDelta
                    os9       I$GetStt
iix                 clrb
                    rts

InExit              tst       MOUSE,u
                    beq       iex
                    clr       MOUSE,u
                    lda       #0
                    ldb       #SS.MsDelta
                    ldx       #0                  pointer mode
                    os9       I$SetStt
iex                 clrb
                    rts
